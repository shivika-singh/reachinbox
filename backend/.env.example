PORT=4000
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# any long random string
JWT_SECRET=change-me-to-a-long-random-string

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID -> Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Slack OAuth (api.slack.com/apps -> your app -> scope: incoming-webhook)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# Scheduler tuning (nothing hard-coded)
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
SENDER_COUNT=3
